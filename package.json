{
  "name": "klinik-reservasi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/dev.js",
    "start:registry": "node services/registry/index.js",
    "start:auth": "node services/auth/index.js",
    "start:clinic": "node services/clinic/index.js",
    "start:notification": "node services/notification/index.js",
    "start:gateway": "node gateway/index.js",
    "dev": "node scripts/dev.js",
    "test": "node --test \"test/*.test.js\"",
    "export:schema": "node scripts/export-schema.js",
    "setup:env": "node scripts/generate-env.js",
    "smoke": "node scripts/smoke.js",
    "db:schema": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f migrations/001_schema.sql",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f migrations/002_seed_data.sql",
    "db:setup": "npm run db:schema && npm run db:seed",
    "db:reset": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f migrations/000_reset_data.sql && npm run db:seed"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "graphql": "^16.9.0",
    "graphql-http": "^1.22.1",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
